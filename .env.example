# Debs Hair Beauty's own PostgreSQL database (e.g. Neon), independent from
# any other project.
DEBS_DATABASE_URL=

# Stripe account dedicated to Debs Hair Beauty.
DEBS_STRIPE_SECRET_KEY=
DEBS_STRIPE_WEBHOOK_SECRET=

# WhatsApp confirmation link. Digits only work too; formatting is normalized.
DEBS_WHATSAPP_NUMBER=
NEXT_PUBLIC_DEBS_WHATSAPP_NUMBER=

NEXT_PUBLIC_DEBS_INSTAGRAM_URL=
NEXT_PUBLIC_DEBS_TIKTOK_URL=

# Real Google reviews on /debs (src/lib/debs-google-reviews.ts) — the
# section renders nothing at all if these are unset. See that file's
# header comment for where to get each value.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Random secret gating /api/debs/calendar (the iCalendar feed the salon
# subscribes to from iPhone/Mac) — that feed carries client names and phone
# numbers, so this must stay private. Generate with: openssl rand -hex 24
DEBS_CALENDAR_FEED_TOKEN=

# Random secret gating /debs/admin and /api/debs/admin/* (Déborah's own
# cancel-appointment tool — no client-facing login exists, this is the only
# thing standing between the public internet and issuing Stripe refunds and
# marking appointments cancelled). Generate with: openssl rand -hex 24
DEBS_ADMIN_TOKEN=

# Post-appointment review request emails (src/app/api/debs/cron/review-requests,
# src/app/[locale]/debs/avis). Get an API key at https://resend.com — the
# free tier covers a small salon's volume comfortably.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend's dashboard, e.g.
# avis@debshairbeauty.com — the review-request emails are sent from this.
DEBS_REVIEW_FROM_EMAIL=
# Déborah's own inbox — gets a private alert when a client leaves 1-3★ so she
# can do service recovery before it becomes a public bad review.
DEBS_OWNER_EMAIL=

# Vercel's own cron-job auth: set this, and Vercel automatically sends it as
# `Authorization: Bearer <value>` on every cron request — no secret needs to
# live in vercel.json. Generate with: openssl rand -hex 24
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=
